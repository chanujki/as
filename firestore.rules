rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: public read, write for store management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Orders collection: public create and read/update
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Chat messages collection: customers and admin can read/write real-time chat
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }
    
    // Store settings: public read, allow updates
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
